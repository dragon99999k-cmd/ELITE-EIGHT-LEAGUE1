<!doctype html>
<html>
<head><meta charset="utf-8"><title>Live Site</title></head>
<body>
  <div id="content"></div>

  <script src="/socket.io/socket.io.js"></script>
  <script>
    const socket = io();
    socket.on('content', html => {
      document.getElementById('content').innerHTML = html;
    });
    // In case socket isn't ready, fetch the initial file
    fetch('/content.html').then(r=>r.ok && r.text()).then(t=>{ if(t) document.getElementById('content').innerHTML = t; });
  </script>
</body>
</html>
